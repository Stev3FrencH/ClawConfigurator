<Page
    x:Class="McenterLite.Widget.MainWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!--
        Layout is three fixed rows: identity, connection notice, content. The first two never
        scroll. When the helper is down every control below it is meaningless, and a banner that
        can be scrolled out of sight while the controls it explains stay visible is worse than no
        banner at all.
    -->
    <!-- Named because Game Bar's transparency setting is applied to it as a whole. -->
    <Grid x:Name="RootContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Identity ─────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="16,16,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="DeviceModelText"
                           FontSize="{StaticResource CardTitleSize}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Not connected" />
                <TextBlock x:Name="DeviceBackendText"
                           FontSize="{StaticResource HintSize}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Connection dot. Colour is driven from code-behind alongside the banner, so the
                 two can never disagree about whether the helper is up. -->
            <Ellipse x:Name="ConnectionDot"
                     Grid.Column="1"
                     Width="10" Height="10"
                     VerticalAlignment="Center"
                     Margin="10,0,2,0"
                     Fill="{StaticResource TextSecondaryBrush}" />
        </Grid>

        <!-- ── Connection notice ────────────────────────────────────────────────────── -->
        <Border x:Name="StatusBanner"
                Grid.Row="1"
                Style="{StaticResource NoticeStyle}"
                BorderBrush="{StaticResource WarningBrush}"
                Margin="16,0,16,12"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource NoticeTextStyle}"
                           Text="Connecting to the helper..." />
                <Button x:Name="StatusActionButton"
                        Content="Retry"
                        Margin="0,12,0,0"
                        Padding="20,8"
                        MinHeight="{StaticResource ControlHeight}"
                        FontSize="{StaticResource BodySize}"
                        CornerRadius="6"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                        Click="StatusActionButton_Click" />
            </StackPanel>
        </Border>

        <!-- ── Content ──────────────────────────────────────────────────────────────── -->
        <!--
            Pressing Up from the top control takes TWO presses to leave the widget: one lands on
            something invisible, the second exits to Game Bar. That is NOT a bug in this widget -
            every Game Bar widget behaves that way, Microsoft's bundled ones included, so it is the
            platform's own navigation model.

            IsTabStop="False" here does suppress it, and was tried. It is deliberately NOT kept:
            matching what every other widget does is worth more than saving a press, and the
            mechanism was never actually confirmed - so it would be an unverified deviation from
            platform behaviour, which is a bad trade in a widget that has to feel native.
        -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,0,16,16">
            <StackPanel>

                <!-- 1. TDP -->
                <Border x:Name="TdpCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE945;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="TDP Control" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sustained" Style="{StaticResource RowLabelStyle}" />
                            <TextBlock x:Name="Pl1ValueText" Grid.Column="1" Style="{StaticResource ValueStyle}" />
                        </Grid>
                        <Slider x:Name="Pl1Slider"
                                Style="{StaticResource CardSliderStyle}"
                                Minimum="8" Maximum="35" StepFrequency="1"
                                TickFrequency="1"
                                ValueChanged="Pl1Slider_ValueChanged" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Boost" Style="{StaticResource RowLabelStyle}" />
                            <TextBlock x:Name="Pl2ValueText" Grid.Column="1" Style="{StaticResource ValueStyle}" />
                        </Grid>
                        <Slider x:Name="Pl2Slider"
                                Style="{StaticResource CardSliderStyle}"
                                Minimum="10" Maximum="45" StepFrequency="1"
                                TickFrequency="1"
                                ValueChanged="Pl2Slider_ValueChanged" />
                    </StackPanel>
                </Border>

                <!-- 2. Windows power -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE713;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Windows power" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <!-- Two buttons rather than a ToggleSwitch. The switch could not be lined
                             up with the segments below it: its template grid carries
                             MinWidth 154 (ToggleSwitchThemeMinWidth) while the visible track is
                             only 44 wide, and that MinWidth is on the template, so setting
                             MinWidth on the control cannot shrink it. Nudging it left with a
                             negative margin would move the track but leave the focus rectangle -
                             SwitchAreaGrid, which spans all three template columns - overhanging
                             the card on a device driven by a stick. Segments align by
                             construction instead. -->
                        <TextBlock Text="CPU boost" Style="{StaticResource RowLabelStyle}" Margin="0,12,0,0" />
                        <Grid x:Name="CpuBoostSegments" Margin="0,6,0,0" />

                        <TextBlock Text="Power mode" Style="{StaticResource RowLabelStyle}" Margin="0,12,0,0" />
                        <Grid x:Name="PowerModeSegments" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 3. Graphics -->
                <Border x:Name="IntelCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7F4;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Graphics" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <!-- "FPS limit" rather than IGCL's own "Endurance Gaming", and the tiers
                             shown as the frame rates they actually cap at. Segment order is set in
                             code by IntelFpsTierSegmentOrder and is deliberately NOT the wire
                             order - the driver numbers these 0/1/2/3 as off/60/40/30, so the
                             numeric tiers run backwards from how they read here. -->
                        <TextBlock Text="FPS limit" Style="{StaticResource RowLabelStyle}" Margin="0,12,0,0" />
                        <Grid x:Name="IntelFpsTierSegments" Margin="0,6,0,0" />

                        <TextBlock Text="Low latency" Style="{StaticResource RowLabelStyle}" Margin="0,12,0,0" />
                        <Grid x:Name="IntelLowLatencySegments" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 4. Controller -->
                <Border x:Name="HwMouseCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7FC;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Controller" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <!-- Two named buttons rather than a toggle. A switch labelled "desktop
                             mouse mode" leaves the off state unnamed, and "off" here is not
                             nothing - it is gamepad mode. Segment order is set in code by
                             HwMouseSegmentOrder. -->
                        <Grid x:Name="HwMouseSegments" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Fan, battery charge limit and RGB lighting all had cards here. All three were
                     removed 2026-08-08 - each is set in MSI Center, and MSI's own controls are
                     better than anything this widget could offer. See docs/hardware-notes.md
                     gates G2, G3 and G4 for the findings, which are kept as a device record. -->

                <!-- A banner warning that MSI Center M was NOT running lived here until
                     2026-08-11. It made sense while the registry mirror was the only TDP path -
                     MSI's own service was what pushed the values to the EC, so with it stopped the
                     write succeeded and nothing happened. WmiTdpProvider writes the EC directly and
                     needs MSI Center M neither running nor installed, so the notice would have
                     become permanently visible and permanently wrong the moment MSI Center M was
                     uninstalled - which is the intended end state, and the state of any fresh
                     Windows install. -->

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
