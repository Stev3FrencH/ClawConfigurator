<Page
    x:Class="McenterLite.Widget.MainWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status banner. Occupies its own row rather than scrolling away, because when the
             helper is down every control below is meaningless and the user needs to know why. -->
        <Border x:Name="StatusBanner"
                Grid.Row="0"
                Background="#332C1A"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8"
                Margin="12,12,12,4"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="Connecting to the helper..." />
                <Button x:Name="StatusActionButton"
                        Content="Retry"
                        Margin="0,8,0,0"
                        FontSize="12"
                        Visibility="Collapsed"
                        Click="StatusActionButton_Click" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12,8,12,12">
            <StackPanel>

                <!-- Device -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Device" Style="{StaticResource CardHeaderStyle}" />
                        <TextBlock x:Name="DeviceModelText"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="Not connected" />
                        <TextBlock x:Name="DeviceBackendText"
                                   Style="{StaticResource HintStyle}" />
                    </StackPanel>
                </Border>

                <!-- 1. TDP -->
                <Border x:Name="TdpCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Power limits" Style="{StaticResource CardHeaderStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sustained (PL1)" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock x:Name="Pl1ValueText" Grid.Column="1" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                        <Slider x:Name="Pl1Slider"
                                Minimum="8" Maximum="35" StepFrequency="1"
                                TickFrequency="1"
                                ValueChanged="Pl1Slider_ValueChanged" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Boost (PL2)" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock x:Name="Pl2ValueText" Grid.Column="1" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                        <Slider x:Name="Pl2Slider"
                                Minimum="10" Maximum="45" StepFrequency="1"
                                TickFrequency="1"
                                ValueChanged="Pl2Slider_ValueChanged" />

                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Boost is held above sustained by the margin the firmware requires. The helper clamps both, so a value may snap back." />
                    </StackPanel>
                </Border>

                <!-- 2. Fan -->
                <Border x:Name="FanCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Fan" Style="{StaticResource CardHeaderStyle}" />

                        <ToggleSwitch x:Name="FanEnabledToggle"
                                      Header="Software fan control"
                                      OnContent="On" OffContent="Off"
                                      Toggled="FanEnabledToggle_Toggled" />

                        <ComboBox x:Name="FanPresetCombo"
                                  Header="Profile"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,8,0,0"
                                  SelectionChanged="FanPresetCombo_SelectionChanged">
                            <ComboBoxItem Content="Default" />
                            <ComboBoxItem Content="Quiet idle" />
                            <ComboBoxItem Content="Cooling" />
                        </ComboBox>

                        <TextBlock x:Name="FanStateText"
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,8,0,0" />

                        <TextBlock x:Name="FanMismatchText"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Visibility="Collapsed"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 3. Battery -->
                <Border x:Name="ChargeCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Battery" Style="{StaticResource CardHeaderStyle}" />

                        <ToggleSwitch x:Name="ChargeLimitToggle"
                                      Header="Limit charging"
                                      OnContent="On" OffContent="Off"
                                      Toggled="ChargeLimitToggle_Toggled" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stop charging at" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock x:Name="ChargeLimitValueText" Grid.Column="1" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                        <!-- The controller accepts 20-100. 60 is our floor by choice, not a hardware
                             limit: below it the limiter stops being a longevity setting and starts
                             being a way to strand yourself on a handheld. -->
                        <Slider x:Name="ChargeLimitSlider"
                                Minimum="60" Maximum="100" StepFrequency="5"
                                TickFrequency="5"
                                ValueChanged="ChargeLimitSlider_ValueChanged" />

                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Stored in the controller, so it survives a reboot." />
                    </StackPanel>
                </Border>

                <!-- 4. Lighting -->
                <Border x:Name="LedCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Lighting" Style="{StaticResource CardHeaderStyle}" />

                        <ComboBox x:Name="LedModeCombo"
                                  Header="Effect"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="LedModeCombo_SelectionChanged">
                            <ComboBoxItem Content="Off" />
                            <ComboBoxItem Content="Static" />
                            <ComboBoxItem Content="Breathing" />
                            <ComboBoxItem Content="Colour cycle" />
                            <ComboBoxItem Content="Wave" />
                        </ComboBox>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Brightness" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock x:Name="LedBrightnessValueText" Grid.Column="1" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                        <Slider x:Name="LedBrightnessSlider"
                                Minimum="0" Maximum="100" StepFrequency="5"
                                ValueChanged="LedBrightnessSlider_ValueChanged" />
                    </StackPanel>
                </Border>

                <!-- 5. Controller -->
                <Border x:Name="HwMouseCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Controller" Style="{StaticResource CardHeaderStyle}" />

                        <ToggleSwitch x:Name="HwMouseToggle"
                                      Header="Desktop mouse mode"
                                      OnContent="Mouse" OffContent="Gamepad"
                                      Toggled="HwMouseToggle_Toggled" />

                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Switches the controller firmware itself, so the cursor keeps working on secure screens such as the elevation prompt. The physical button changes this too." />
                    </StackPanel>
                </Border>

                <!-- 6 and 7. Windows power -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Windows power" Style="{StaticResource CardHeaderStyle}" />

                        <ToggleSwitch x:Name="CpuBoostToggle"
                                      Header="CPU boost"
                                      OnContent="On" OffContent="Off"
                                      Toggled="CpuBoostToggle_Toggled" />

                        <ComboBox x:Name="PowerModeCombo"
                                  Header="Power mode"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,8,0,0"
                                  SelectionChanged="PowerModeCombo_SelectionChanged">
                            <ComboBoxItem Content="Best power efficiency" />
                            <ComboBoxItem Content="Balanced" />
                            <ComboBoxItem Content="Best performance" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="These are Windows settings and apply system-wide." />
                    </StackPanel>
                </Border>

                <!-- 8. Graphics -->
                <Border x:Name="IntelCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Graphics" Style="{StaticResource CardHeaderStyle}" />

                        <ComboBox x:Name="IntelFpsTierCombo"
                                  Header="Endurance gaming"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="IntelFpsTierCombo_SelectionChanged">
                            <ComboBoxItem Content="Off" />
                            <ComboBoxItem Content="Performance (60 fps)" />
                            <ComboBoxItem Content="Balanced (40 fps)" />
                            <ComboBoxItem Content="Efficiency (30 fps)" />
                        </ComboBox>

                        <ComboBox x:Name="IntelLowLatencyCombo"
                                  Header="Low latency"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,8,0,0"
                                  SelectionChanged="IntelLowLatencyCombo_SelectionChanged">
                            <ComboBoxItem Content="Off" />
                            <ComboBoxItem Content="On" />
                            <ComboBoxItem Content="On + boost" />
                        </ComboBox>

                        <!-- Honest wording: the driver applies this per executable, so a global
                             switch would be a lie. -->
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Applies to the game currently in focus, not system-wide." />
                    </StackPanel>
                </Border>

                <!-- Dependency warning.
                     This warns when MSI Center M is NOT running, which reads backwards until you
                     know the TDP path: we write MSI Center's own registry model and its service is
                     what pushes the values to the EC. With the service stopped the write succeeds
                     and nothing happens - the worst kind of failure, so it gets a banner. -->
                <Border x:Name="MsiCenterWarning"
                        Background="#332C1A"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,4,0,8"
                        Visibility="Collapsed">
                    <TextBlock FontSize="11"
                               TextWrapping="Wrap"
                               Text="MSI Center M is not running. Power limits are applied through it, so they will not take effect until it is started." />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
