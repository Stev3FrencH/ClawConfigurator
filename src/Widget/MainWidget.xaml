<Page
    x:Class="McenterLite.Widget.MainWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!--
        Layout is three fixed rows: identity, connection notice, content. The first two never
        scroll. When the helper is down every control below it is meaningless, and a banner that
        can be scrolled out of sight while the controls it explains stay visible is worse than no
        banner at all.
    -->
    <!-- Named because Game Bar's transparency setting is applied to it as a whole. -->
    <!--
        XYFocusKeyboardNavigation="Enabled" is what lets the ARROW KEYS move focus. A gamepad gets XY
        navigation for free - which is why the gamepad was always fine - but a keyboard does not, and
        without this its arrows do nothing and only Tab moves.

        HISTORY, because this line was added, reverted, and added again. It went in at 0.2.0.12 and
        was pulled at 0.2.0.14 after keyboard navigation got worse, not better. That was a misread:
        the widget was still grabbing focus onto the ScrollViewer and the PL1 slider at the time, so
        the arrows had nowhere sane to start from and the damage was blamed on XY. The grab was
        deleted in 0.2.0.17 - see the MainWidget class remarks - and with it gone this is simply the
        switch that makes arrow keys work. It is independent of Tab, which never needed it.
    -->
    <Grid x:Name="RootContent" XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Identity ─────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="16,16,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="DeviceModelText"
                           FontSize="{StaticResource CardTitleSize}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Not connected" />
                <TextBlock x:Name="DeviceBackendText"
                           FontSize="{StaticResource HintSize}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Connection dot. Colour is driven from code-behind alongside the banner, so the
                 two can never disagree about whether the helper is up. -->
            <Ellipse x:Name="ConnectionDot"
                     Grid.Column="1"
                     Width="10" Height="10"
                     VerticalAlignment="Center"
                     Margin="10,0,2,0"
                     Fill="{StaticResource TextSecondaryBrush}" />
        </Grid>

        <!-- ── Connection notice ────────────────────────────────────────────────────── -->
        <Border x:Name="StatusBanner"
                Grid.Row="1"
                Style="{StaticResource NoticeStyle}"
                BorderBrush="{StaticResource WarningBrush}"
                Margin="16,0,16,12"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource NoticeTextStyle}"
                           Text="Connecting to the helper..." />
                <Button x:Name="StatusActionButton"
                        Content="Retry"
                        Margin="0,12,0,0"
                        Padding="20,8"
                        MinHeight="{StaticResource ControlHeight}"
                        FontSize="{StaticResource BodySize}"
                        CornerRadius="6"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                        Click="StatusActionButton_Click" />
            </StackPanel>
        </Border>

        <!-- ── Content ──────────────────────────────────────────────────────────────── -->
        <!--
            Pressing Up from the top control takes TWO presses to leave the widget: one lands on
            something invisible, the second exits to Game Bar. That is NOT a bug in this widget -
            every Game Bar widget behaves that way, Microsoft's bundled ones included, so it is the
            platform's own navigation model.

            IsTabStop="False" here does suppress it, and was tried. It is deliberately NOT kept:
            matching what every other widget does is worth more than saving a press, and the
            mechanism was never actually confirmed - so it would be an unverified deviation from
            platform behaviour, which is a bad trade in a widget that has to feel native.
        -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,0,16,16">
            <StackPanel>

                <!-- 1. Controller. FIRST on purpose: it is the only card here that changes what
                     the buttons under your thumbs do, so it is the one most likely to be wanted in
                     a hurry - and it is also where initial focus lands. -->
                <Border x:Name="HwMouseCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7FC;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Controller" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <!-- Two named buttons rather than a toggle. A switch labelled "desktop
                             mouse mode" leaves the off state unnamed, and "off" here is not
                             nothing - it is gamepad mode. Segment order is set in code by
                             HwMouseSegmentOrder. -->
                        <Grid x:Name="HwMouseSegments" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- 2. TDP -->
                <Border x:Name="TdpCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE945;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="TDP Control" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sustained" Style="{StaticResource RowLabelStyle}" />
                            <TextBlock x:Name="Pl1ValueText" Grid.Column="1" Style="{StaticResource ValueStyle}" />
                        </Grid>
                        <!-- KeyDown on every slider so Escape RELEASES a gamepad-engaged slider
                             rather than falling through to Game Bar, which reads it as close. See
                             Slider_KeyDown; it handles nothing else. -->
                        <Slider x:Name="Pl1Slider"
                                Style="{StaticResource CardSliderStyle}"
                                Minimum="8" Maximum="35" StepFrequency="1"
                                TickFrequency="1"
                                KeyDown="Slider_KeyDown"
                                ValueChanged="Pl1Slider_ValueChanged" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Boost" Style="{StaticResource RowLabelStyle}" />
                            <TextBlock x:Name="Pl2ValueText" Grid.Column="1" Style="{StaticResource ValueStyle}" />
                        </Grid>
                        <Slider x:Name="Pl2Slider"
                                Style="{StaticResource CardSliderStyle}"
                                Minimum="10" Maximum="45" StepFrequency="1"
                                TickFrequency="1"
                                KeyDown="Slider_KeyDown"
                                ValueChanged="Pl2Slider_ValueChanged" />
                    </StackPanel>
                </Border>

                <!-- 3. Windows power -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE713;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Windows power" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <!-- Two buttons rather than a ToggleSwitch. The switch could not be lined
                             up with the segments below it: its template grid carries
                             MinWidth 154 (ToggleSwitchThemeMinWidth) while the visible track is
                             only 44 wide, and that MinWidth is on the template, so setting
                             MinWidth on the control cannot shrink it. Nudging it left with a
                             negative margin would move the track but leave the focus rectangle -
                             SwitchAreaGrid, which spans all three template columns - overhanging
                             the card on a device driven by a stick. Segments align by
                             construction instead. -->
                        <TextBlock Text="CPU boost" Style="{StaticResource RowLabelStyle}" Margin="0,12,0,0" />
                        <Grid x:Name="CpuBoostSegments" Margin="0,6,0,0" />

                        <TextBlock Text="Power mode" Style="{StaticResource RowLabelStyle}" Margin="0,12,0,0" />
                        <Grid x:Name="PowerModeSegments" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 4. Graphics -->
                <Border x:Name="IntelCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7F4;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Graphics" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <!-- "FPS limit" rather than IGCL's own "Endurance Gaming", and the tiers
                             shown as the frame rates they actually cap at. Segment order is set in
                             code by IntelFpsTierSegmentOrder and is deliberately NOT the wire
                             order - the driver numbers these 0/1/2/3 as off/60/40/30, so the
                             numeric tiers run backwards from how they read here. -->
                        <TextBlock Text="FPS limit" Style="{StaticResource RowLabelStyle}" Margin="0,12,0,0" />
                        <Grid x:Name="IntelFpsTierSegments" Margin="0,6,0,0" />

                        <TextBlock Text="Low latency" Style="{StaticResource RowLabelStyle}" Margin="0,12,0,0" />
                        <Grid x:Name="IntelLowLatencySegments" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 3b. Battery charge limit -->
                <Border x:Name="ChargeLimitCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE83E;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Battery" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <!-- Bounds come from DeviceCaps at runtime, not from this markup; the
                             values here are only what XAML shows before the first snapshot.
                             50-100 in tens is a deliberate product range - the FIRMWARE accepts
                             20-100, but nothing below half charge is useful for longevity, so the
                             travel is spent where the values matter. See DeviceCaps. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Charge to" Style="{StaticResource RowLabelStyle}" />
                            <TextBlock x:Name="ChargeLimitValueText" Grid.Column="1" Style="{StaticResource ValueStyle}" />
                        </Grid>
                        <Slider x:Name="ChargeLimitSlider"
                                Style="{StaticResource CardSliderStyle}"
                                Minimum="50" Maximum="100" StepFrequency="10"
                                TickFrequency="10"
                                KeyDown="Slider_KeyDown"
                                ValueChanged="ChargeLimitSlider_ValueChanged" />
                    </StackPanel>
                </Border>

                <!-- 5. Lighting. LAST on purpose: it is the card least likely to be wanted
                     mid-game, so it costs the least to be furthest from the top. -->
                <Border x:Name="LightingCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE781;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Lighting" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <!-- Four segments: Off, then the three profiles. There is deliberately no
                             colour picker - the profiles are text files the user edits, and this
                             card only chooses between them. The three labels are the profile
                             NAMES and are filled in from the helper at runtime, because renaming
                             a profile means editing its file. See LightingProfileStore. -->
                        <!-- No hint line here. Explaining where the profile files live cost two
                             wrapped lines on every open, to say something a user needs once - and
                             the folder carries its own README.txt anyway. It is in the repo README
                             instead. -->
                        <Grid x:Name="LightingSegments" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Fan control had a card here. Removed 2026-08-08 and still absent: gate G2
                     never reconciled MSI's six-point curve with the five-point model the desk
                     research described, so nothing was ever written to the EC. The battery
                     charge limit and RGB lighting were removed alongside it and have both since
                     come back, on firmware paths rather than MSI Center. See
                     docs/hardware-notes.md. -->

                <!-- A banner warning that MSI Center M was NOT running lived here until
                     2026-08-11. It made sense while the registry mirror was the only TDP path -
                     MSI's own service was what pushed the values to the EC, so with it stopped the
                     write succeeded and nothing happened. WmiTdpProvider writes the EC directly and
                     needs MSI Center M neither running nor installed, so the notice would have
                     become permanently visible and permanently wrong the moment MSI Center M was
                     uninstalled - which is the intended end state, and the state of any fresh
                     Windows install. -->

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
