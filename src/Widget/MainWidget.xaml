<Page
    x:Class="McenterLite.Widget.MainWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!--
        Layout is three fixed rows: identity, connection notice, content. The first two never
        scroll. When the helper is down every control below it is meaningless, and a banner that
        can be scrolled out of sight while the controls it explains stay visible is worse than no
        banner at all.
    -->
    <!-- Named because Game Bar's transparency setting is applied to it as a whole. -->
    <Grid x:Name="RootContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Identity ─────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="16,16,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="DeviceModelText"
                           FontSize="{StaticResource CardTitleSize}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Not connected" />
                <TextBlock x:Name="DeviceBackendText"
                           FontSize="{StaticResource HintSize}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Connection dot. Colour is driven from code-behind alongside the banner, so the
                 two can never disagree about whether the helper is up. -->
            <Ellipse x:Name="ConnectionDot"
                     Grid.Column="1"
                     Width="10" Height="10"
                     VerticalAlignment="Center"
                     Margin="10,0,2,0"
                     Fill="{StaticResource TextSecondaryBrush}" />
        </Grid>

        <!-- ── Connection notice ────────────────────────────────────────────────────── -->
        <Border x:Name="StatusBanner"
                Grid.Row="1"
                Style="{StaticResource NoticeStyle}"
                BorderBrush="{StaticResource WarningBrush}"
                Margin="16,0,16,12"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource NoticeTextStyle}"
                           Text="Connecting to the helper..." />
                <Button x:Name="StatusActionButton"
                        Content="Retry"
                        Margin="0,12,0,0"
                        Padding="20,8"
                        MinHeight="{StaticResource ControlHeight}"
                        FontSize="{StaticResource BodySize}"
                        CornerRadius="6"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"
                        Click="StatusActionButton_Click" />
            </StackPanel>
        </Border>

        <!-- ── Content ──────────────────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,0,16,16">
            <StackPanel>

                <!-- 1. TDP -->
                <Border x:Name="TdpCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE945;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Power limits" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <!-- Mode sits ABOVE the sliders because it gates them: MSI only honours
                             manual limits in User Scenario. Order matches PerfMode's ordinals. -->
                        <Grid x:Name="PerfModeSegments" Margin="0,12,0,0" />

                        <TextBlock x:Name="PerfModeHint"
                                   Style="{StaticResource HintStyle}"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="MSI is managing power in this mode. Switch to User Scenario to set limits yourself." />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sustained" Style="{StaticResource RowLabelStyle}" />
                            <TextBlock x:Name="Pl1ValueText" Grid.Column="1" Style="{StaticResource ValueStyle}" />
                        </Grid>
                        <Slider x:Name="Pl1Slider"
                                Style="{StaticResource CardSliderStyle}"
                                Minimum="8" Maximum="35" StepFrequency="1"
                                TickFrequency="1"
                                ValueChanged="Pl1Slider_ValueChanged" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Boost" Style="{StaticResource RowLabelStyle}" />
                            <TextBlock x:Name="Pl2ValueText" Grid.Column="1" Style="{StaticResource ValueStyle}" />
                        </Grid>
                        <Slider x:Name="Pl2Slider"
                                Style="{StaticResource CardSliderStyle}"
                                Minimum="10" Maximum="45" StepFrequency="1"
                                TickFrequency="1"
                                ValueChanged="Pl2Slider_ValueChanged" />
                    </StackPanel>
                </Border>

                <!-- 2. Fan -->
                <Border x:Name="FanCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE72C;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Fan" Style="{StaticResource CardTitleStyle}" />
                            <ToggleSwitch x:Name="FanEnabledToggle"
                                          Grid.Column="2"
                                          Style="{StaticResource CompactToggleStyle}"
                                          Toggled="FanEnabledToggle_Toggled" />
                        </Grid>

                        <!-- The three shipping presets, named as ClawTweaks names them. It also
                             offers Custom and a debug entry; neither is in scope here. -->
                        <Button x:Name="FanPresetButton"
                                Style="{StaticResource CycleButtonStyle}"
                                Margin="0,12,0,0"
                                Click="FanPresetButton_Click" />

                        <TextBlock x:Name="FanStateText"
                                   Style="{StaticResource HintStyle}" />

                        <TextBlock x:Name="FanMismatchText"
                                   FontSize="{StaticResource HintSize}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Visibility="Collapsed"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 3. Battery charge limit was here. Removed 2026-08-08: it is set in MSI
                     Center, changes rarely, and the registry path this app could reach did not
                     enforce it. See docs/hardware-notes.md Gate G3. -->

                <!-- 4. Lighting -->
                <!-- On/off only. The vendor HID report that would carry mode/colour/effect is
                     still undecoded (Gate G4 in hardware-notes.md) - the registry only holds an
                     on/off switch, so that is all this card offers. -->
                <Border x:Name="LedCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE790;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Lighting" Style="{StaticResource CardTitleStyle}" />
                            <ToggleSwitch x:Name="LedToggle"
                                          Grid.Column="2"
                                          Style="{StaticResource CompactToggleStyle}"
                                          Toggled="LedToggle_Toggled" />
                        </Grid>

                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="MSI's performance mode also controls this - Endurance turns lighting off, leaving it turns it back on." />
                    </StackPanel>
                </Border>

                <!-- 5. Controller -->
                <Border x:Name="HwMouseCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7FC;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Desktop mouse mode" Style="{StaticResource CardTitleStyle}" />
                            <ToggleSwitch x:Name="HwMouseToggle"
                                          Grid.Column="2"
                                          Style="{StaticResource CompactToggleStyle}"
                                          Toggled="HwMouseToggle_Toggled" />
                        </Grid>

                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Switches the controller firmware itself, so the cursor keeps working on secure screens such as the elevation prompt. The physical button changes this too." />
                    </StackPanel>
                </Border>

                <!-- 6 and 7. Windows power -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE713;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Windows power" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU boost" Style="{StaticResource RowLabelStyle}" />
                            <ToggleSwitch x:Name="CpuBoostToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource CompactToggleStyle}"
                                          Toggled="CpuBoostToggle_Toggled" />
                        </Grid>

                        <TextBlock Text="Power mode" Style="{StaticResource RowLabelStyle}" Margin="0,12,0,0" />
                        <Grid x:Name="PowerModeSegments" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 8. Graphics -->
                <Border x:Name="IntelCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7F4;" Style="{StaticResource CardIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Graphics" Style="{StaticResource CardTitleStyle}" />
                        </Grid>

                        <TextBlock Text="Endurance gaming" Style="{StaticResource RowLabelStyle}" Margin="0,12,0,0" />
                        <Button x:Name="IntelFpsTierButton"
                                Style="{StaticResource CycleButtonStyle}"
                                Click="IntelFpsTierButton_Click" />

                        <TextBlock Text="Low latency" Style="{StaticResource RowLabelStyle}" Margin="0,12,0,0" />
                        <Button x:Name="IntelLowLatencyButton"
                                Style="{StaticResource CycleButtonStyle}"
                                Click="IntelLowLatencyButton_Click" />

                        <!-- Honest wording: the driver applies this per executable, so a global
                             switch would be a lie. -->
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Applies to the game currently in focus, not system-wide." />
                    </StackPanel>
                </Border>

                <!-- Dependency notice.
                     This warns when MSI Center M is NOT running, which reads backwards until you
                     know the TDP path: we write MSI Center's own registry model and its service is
                     what pushes the values to the EC. With the service stopped the write succeeds
                     and nothing happens - the worst kind of failure, so it gets a banner. -->
                <Border x:Name="MsiCenterWarning"
                        Style="{StaticResource NoticeStyle}"
                        BorderBrush="{StaticResource WarningBrush}"
                        Margin="0,0,0,4"
                        Visibility="Collapsed">
                    <TextBlock Style="{StaticResource NoticeTextStyle}"
                               Text="MSI Center M is not running. Power limits are applied through it, so they will not take effect until it is started." />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
