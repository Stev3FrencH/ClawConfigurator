<Application
    x:Class="McenterLite.Widget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                PALETTE

                Deliberately self-contained rather than built on WinUI's theme-resource keys
                (CardBackgroundFillColorDefaultBrush and friends). Those would be the idiomatic
                choice, but a StaticResource that does not resolve is a RUNTIME CRASH, and this
                project cannot compile the widget on the authoring machine to find out. Local
                brushes cost a few lines and cannot fail that way.

                Strokes and fills are alpha over white rather than opaque greys. The Game Bar
                composites this over live gameplay, so translucent edges keep their definition
                against whatever is behind them; fixed greys look correct on a dark menu and
                muddy over a bright scene.
            -->

            <!-- Surfaces -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#D91B2129" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#0AFFFFFF" />

            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F5F9" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#96A2B2" />

            <!-- Accent. #4CC2FF is the Windows 11 dark-theme accent, so the widget reads as part
                 of the shell rather than as a third-party panel sitting on top of it. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />

            <!-- Status. SuccessBrush and TextSecondaryBrush are resolved BY NAME from
                 MainWidget.SetConnectionDot, so they have no XAML reference - do not delete either
                 on the grounds that nothing appears to use it. -->
            <SolidColorBrush x:Key="WarningBrush" Color="#FFC46B" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF7A6B" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#6BD98A" />

            <!--
                SIZE AND TYPE SCALE

                All sizes are effective pixels, so they stay physically consistent whatever display
                scaling the device is set to. Sized for the one device this ships to: an 8-inch
                1920x1200 panel at 283 PPI, driven with a thumb and a gamepad.

                ControlHeight is 44 rather than Microsoft's 40 epx touch minimum, which buys margin
                without costing a card per screen. On this panel that is 7.9 mm at 200% scaling and
                9.9 mm at 250% - inside the recommended 7-9 mm band either way. The previous 32 epx
                sliders measured 5.7 mm, well under.

                The Game Bar design guide asks for larger content in Compact mode than Desktop.
                There is one scale here, permanently at the larger end, because the target is a
                handheld in both modes. See docs/building-the-widget.md.
            -->
            <x:Double x:Key="ControlHeight">44</x:Double>
            <x:Double x:Key="CardTitleSize">16</x:Double>
            <x:Double x:Key="BodySize">14</x:Double>
            <x:Double x:Key="HintSize">12</x:Double>
            <Thickness x:Key="CardPadding">16</Thickness>
            <Thickness x:Key="CardGap">0,0,0,12</Thickness>

            <!-- ── Cards ───────────────────────────────────────────────────────────────── -->

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
                <Setter Property="Margin" Value="{StaticResource CardGap}" />
            </Style>

            <!-- Card header icon. Segoe Fluent Icons is the Windows 11 face; the comma fallback
                 picks up Segoe MDL2 Assets where it is missing. Every glyph used in this app is
                 one the reference widget already ships on this device. -->
            <Style x:Key="CardIconStyle" TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="{StaticResource CardTitleSize}" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource CardTitleSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--
                The live number for a card, right-aligned in the header row.

                MinWidth plus right alignment, rather than tabular figures: UWP's TextBlock has no
                FontFeatures property, so proportional digits are unavoidable. Reserving the width
                of the widest value instead means the text re-flows inside a fixed box and the
                label to its left never shifts as a slider is dragged.
            -->
            <Style x:Key="ValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource BodySize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="MinWidth" Value="52" />
            </Style>

            <Style x:Key="RowLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource BodySize}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="HintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource HintSize}" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="LineHeight" Value="17" />
            </Style>

            <!-- ── Controls ────────────────────────────────────────────────────────────── -->

            <!--
                Label-left / switch-right, the Windows 11 Settings pattern, instead of the stock
                ToggleSwitch header stacked above a switch captioned "On"/"Off". Blanking the
                content and dropping MinWidth is what makes that layout possible - the default
                154px MinWidth exists to reserve room for the caption text.
            -->
            <!-- CompactToggleStyle was here. Every ToggleSwitch is now a two-segment button pair
                 instead: the switch cannot be right-aligned with the segments around it, because
                 its template grid carries MinWidth 154 against a 44-wide visible track and that
                 MinWidth is inside the template, out of reach of the control's own MinWidth. -->

            <!-- Sliders get a taller hit area than the desktop default. This runs on a handheld:
                 every interaction is a thumb or a stick, never a mouse. -->
            <Style x:Key="CardSliderStyle" TargetType="Slider">
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
                <Setter Property="IsThumbToolTipEnabled" Value="False" />
            </Style>


            <!--
                A fixed row of individually-clickable options, the active one highlighted. The only
                selector this widget uses.

                It replaced a ComboBox first, then a cycle-button that showed one option at a time.
                This is a gamepad-first decision rather than a stylistic one: the Claw is driven
                with a controller, and a ComboBox costs a press to open the flyout, D-pad travel
                through a popup that steals focus from the card, and a second press to commit - and
                the popup can render outside the widget's bounds in the Game Bar. The cycle-button
                fixed all that but still read as a dropdown and hid the other choices until pressed.

                Showing every option at once costs vertical space and wins it back elsewhere: no
                option list here exceeds four, and the widest row (four FPS tiers) is still short
                labels. It also deletes a bug class - a ComboBox raises SelectionChanged while XAML
                applies its markup defaults during construction, which is why every helper-driven
                update needs a guard. A Button raises Click only when something clicks it.
            -->
            <Style x:Key="SegmentButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="4,6" />
                <Setter Property="Margin" Value="2,0,2,0" />
                <Setter Property="FontSize" Value="{StaticResource BodySize}" />
                <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The active segment. Dark-on-accent rather than white-on-accent - #4CC2FF is light
                 enough that white text loses contrast. -->
            <Style x:Key="SegmentButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#1B2129" />
            </Style>

            <!-- Inline notice used for both the connection banner and the MSI Center notice. -->
            <Style x:Key="NoticeStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1,1,1,1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="11,9" />
            </Style>

            <Style x:Key="NoticeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource HintSize}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="LineHeight" Value="17" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
