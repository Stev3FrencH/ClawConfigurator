# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]pp[Pp]ackages/
[Bb]undle[Aa]rtifacts/
*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
dist/

# Signing material — never commit
*.pfx
*.snk
*.cer
*.p12

# Hardware discovery artifacts (Phase 0). The *notes* are checked in
# (docs/hardware-notes.md); the raw dumps are large, machine-specific
# and may embed serial numbers.
/acpi/
*.aml
*.dsl
*.etl
*.pml
Diagnostics/transcripts/
Diagnostics/*.reg

# Decompiler scratch — see LICENSE-NOTES.md. Never commit third-party
# binaries or their decompiled sources.
/decompiled/
/thirdparty-bin/

# Visual Studio / Rider
.vs/
.idea/
*.user
*.suo
*.userprefs
_ReSharper*/

# macOS
.DS_Store

# NuGet
*.nupkg
packages/
!**/packages.config

# Logs
*.log

# Restore point written by Diagnostics/Test-TdpRegistryApply.ps1. Machine-specific, and stale
# copies are actively dangerous - they would restore another unit's power limits.
Diagnostics/tdp-test-backup.json

# Placeholder tile art, regenerated by src/Widget/New-PlaceholderAssets.ps1. Generated binaries in
# a repository are a merge conflict waiting to happen, and these take two seconds to recreate.
src/Widget/Assets/
src/Package/Assets/
